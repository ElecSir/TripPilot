# cp .env.example .env — необязательно: без .env используются значения по умолчанию ниже.
# .env с реальными значениями никогда не коммитится (он в .gitignore и .dockerignore).
# Пароли ниже — локальные значения по умолчанию: БД и pgAdmin доступны только с этого компьютера.
# Если проект разворачивается где-то ещё — задайте свои.

# PostgreSQL. DATABASE_URL для контейнеров собирается из этих переменных в docker-compose.yml.
# Пароль применяется при первом создании БД; чтобы сменить его у существующей — docker compose down -v.
POSTGRES_USER=trip
POSTGRES_PASSWORD=trip
POSTGRES_DB=trip

# pgAdmin (только docker compose --profile tools up): вход на http://localhost:5050.
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=dev

LOG_LEVEL=INFO

# LLM через любое OpenAI-совместимое API. Пустой ключ → режим без LLM.
# Заполняйте в .env, а не здесь: этот файл — образец, он хранится в git.
# Ключ — только в .env: не в код, не в чат, не в описание PR.
# Пример для OpenRouter (из России — через VPN, см. README, «Режим с LLM»):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=dots-studio/dots-3-note-preview:free
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDINGS_MODEL=
LLM_MAX_CONCURRENCY=8
# Сколько секунд ждать модель на одном шаге; бесплатные модели медленные — дольше идут правила.
LLM_STEP_TIMEOUT=15
DEMO_MODE=auto
