# Список переменных без значений. cp .env.example .env — необязательно: пустая переменная
# означает значение по умолчанию (оно указано в комментарии), без .env проект тоже запускается.
# .env с реальными значениями никогда не коммитится (он в .gitignore и .dockerignore).
# Ключи для жюри передаются только зашифрованными: secrets.env.age (см. README, «Режим с LLM»).

# PostgreSQL. DATABASE_URL для контейнеров собирается из этих переменных в docker-compose.yml.
# По умолчанию trip / trip / trip: БД доступна только внутри compose и с этого компьютера.
# Пароль применяется при первом создании БД; чтобы сменить его у существующей — docker compose down -v.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# pgAdmin (только docker compose --profile tools up): вход на http://localhost:5050.
# По умолчанию dev@example.com / dev.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Уровень логов, по умолчанию INFO.
LOG_LEVEL=

# LLM через любое OpenAI-совместимое API. Пустой ключ → режим без LLM (правила и шаблоны).
# Заполняйте в .env, а не здесь: этот файл — образец, он хранится в git.
# Ключ провайдера LLM — только в .env: не в код, не в чат, не в описание PR.
# Мы используем OpenRouter (из России — через VPN, см. README, «Режим с LLM»):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=dots-studio/dots-3-note-preview:free
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Модель эмбеддингов с размерностью 1024; пусто — поиск по базе знаний полнотекстовый.
EMBEDDINGS_MODEL=
# Одновременных запросов к LLM на процесс, по умолчанию 8.
LLM_MAX_CONCURRENCY=
# Сколько секунд ждать модель на одном шаге, по умолчанию 15; дольше — правила.
LLM_STEP_TIMEOUT=
# auto (по умолчанию): без ключа — режим без LLM.
DEMO_MODE=
